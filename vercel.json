{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api-docs(.*)", "dest": "backend/server.js" },
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/assets/(.*)", "dest": "/frontend/dist/assets/$1" },
    { "src": "/favicon.svg(.*)", "dest": "/frontend/dist/favicon.svg" },
    { "src": "/favicon.ico(.*)", "dest": "/frontend/dist/favicon.ico" },
    { "src": "/favicon.png(.*)", "dest": "/frontend/dist/favicon.png" },
    { "src": "/icons.svg(.*)", "dest": "/frontend/dist/icons.svg" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}